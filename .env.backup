# Docker and Server
SERVER_PORT=8000
OXIGRAPH_CONTAINER=oxigraph
ZOTERO_RDF_SERVER_CONTAINER=zotero-rdf-server

# Paths on host (./ = should relative to WORKDIR)
WORKDIR=.. # if your Python workdir is set to src in Dockerfile move one directory up or set absolute
CONFIG_FILE_HOST=./app/config.yaml
ZOTERO_CONFIG_FILE_HOST=./app/zotero.yaml
STORE_DIRECTORY=./app/data
PLUGINS_DIRECTORY=./app/plugins
EXPORT_DIRECTORY=./app/exports
IMPORT_DIRECTORY=./app/import
BACKUP_DIRECTORY=./app/backup
FTS_CONFIG=./app/plugins/fts/config.yml

# Secrets
Z_API_KEY_VISMAG=xyz

# Volumes in Docker container
ZOTERO_CONFIG_FILE=/app/zotero.yaml
CONFIG_FILE=/app/config.yaml

# OpenSearch
OPENSEARCH_CONTAINER=opensearch
OPENSEARCH_DASHBOARDS_CONTAINER=opensearch-dashboards
OPENSEARCH_VERSION=2.14.0
OPENSEARCH_DASHBOARDS_VERSION=2.14.0

OPENSEARCH_HTTP_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_TRANSPORT_PORT=9600

OPENSEARCH_HEAP=1g
OPENSEARCH_CLUSTER_NAME=opensearch
OPENSEARCH_NODE_NAME=opensearch-1

OPENSEARCH_SECURITY_DISABLED=true
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Str0ng-Passw0rd!

OPENSEARCH_DATA_DIR=./app/opensearch-data