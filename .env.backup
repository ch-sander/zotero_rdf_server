# Docker and Server
SERVER_PORT=8000
OXIGRAPH_CONTAINER=oxigraph
ZOTERO_RDF_SERVER_CONTAINER=zotero-rdf-server

# Paths on host (./ = should relative) for Docker volumes
CONFIG_FILE_HOST=./app/config.yaml
ZOTERO_CONFIG_FILE_HOST=./app/zotero.yaml
STORE_DIRECTORY=./app/data
PARSER_DIRECTORY=./app/parser
EXPORT_DIRECTORY=./app/exports
IMPORT_DIRECTORY=./app/import
BACKUP_DIRECTORY=./app/backup

# Inside Docker container or for local runtime
WORKDIR=.. # as your Python workdir is set to /src move one directory up (..) or set absolute
ZOTERO_CONFIG_FILE=/app/zotero.yaml # (set to relative paths if run outside container)
CONFIG_FILE=/app/config.yaml # (set to relative paths if run outside container)