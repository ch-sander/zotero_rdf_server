		zot:shortTitle "意外的圣地中国西北的共产主义革命" ;
		zot:dateModified "2024-12-12T21:00:05Z"^^xsd:dateTime ;
		zot:tags <https://www.zotero.org/entities/tag/b16cd58d-8b07-5b62-b816-19eb5f526c45> , <https://www.zotero.org/entities/tag/755c9cff-a44c-5890-8059-483dc3ed9bd0> , <https://www.zotero.org/entities/tag/c2fcc545-e046-5444-bfa4-6d469b3a8cea> , <https://www.zotero.org/entities/tag/6252f577-03d3-5c78-b792-69eb48727718> , <https://www.zotero.org/entities/tag/e317325a-0819-5585-ac40-5b123af59831> , <https://www.zotero.org/entities/tag/ea39cb4e-0788-53e5-b87e-ee3b517cded4> , <https://www.zotero.org/entities/tag/f1188b33-b2aa-5bb5-bcb5-3199748af35e> , <https://www.zotero.org/entities/tag/130c68d6-ef82-5c67-ac30-7a573bb137ae> , <https://www.zotero.org/entities/tag/78b04fa6-760c-5651-8573-ca289979d4c5> , <https://www.zotero.org/entities/tag/e91a9833-28be-5e7b-9c87-4b9466a393b6> ;
