		zot:shortTitle "在西卢巴写作：从殖民灭绝到全球化挑战" ;
		zot:dateModified "2024-12-12T20:59:41Z"^^xsd:dateTime ;
		zot:tags <https://www.zotero.org/entities/tag/433024b1-d1a5-5771-997b-685ecdc85937> , <https://www.zotero.org/entities/tag/b16cd58d-8b07-5b62-b816-19eb5f526c45> , <https://www.zotero.org/entities/tag/d8f25e59-27af-5070-a750-14619ff19902> , <https://www.zotero.org/entities/tag/e0a0efa5-ba8c-5176-8938-ac4f70908a26> , <https://www.zotero.org/entities/tag/e5ae5ab6-3562-5285-973b-8f825ef6c080> , <https://www.zotero.org/entities/tag/d062ab74-50de-55a3-93ea-b73e149378d0> , <https://www.zotero.org/entities/tag/5f9edee2-05bb-5da4-b975-d38f3dabf9fb> , <https://www.zotero.org/entities/tag/43d1d7c8-8e1d-5f8b-8a57-a7698dc04606> , <https://www.zotero.org/entities/tag/0aa30446-76b0-5c3f-bcf5-93b0b04f7b58> , <https://www.zotero.org/entities/tag/0d9fd21f-b232-5506-8266-860fca8a6ed5> , <https://www.zotero.org/entities/tag/2362c54f-99ea-5fc2-a136-11d1aed35bb8> , <https://www.zotero.org/entities/tag/8407c7d1-f104-5fae-9a92-d9f5ef30fc69> , <https://www.zotero.org/entities/tag/e5723bff-82c1-5e9f-bf3e-385427044f35> , <https://www.zotero.org/entities/tag/5e0d35ae-91d6-5838-9ee7-4115d878e820> ;
		zot:callNumber "0" ;
