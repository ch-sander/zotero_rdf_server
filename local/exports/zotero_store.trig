		zot:pages "359-380" ;
		zot:creators _:a96513183ca40daeaa5525d6ce9094da , _:ecc2e0d30106e35d9584ebf25d22de44 ;
		zot:url <https://library.oapen.org/handle/20.500.12657/59183> ;
		rdfs:label "Fraiture: Tracking the Potholes of Colonial History: Sinzo Aanza's Généalogie d'une banalité and Fiston Mwanza Mujila's Tram 83 (2022)" .
	<https://www.zotero.org/groups/5250572/items/WQR3V47K> zot:extra "🏷️ /unread、History、Historiography、bic Book Industry Communication::H Humanities::HB History::HBA History: theory & methods::HBAH Historiography" ;
		zot:version "46" ;
		a zot:bookSection , zot:item ;
		zot:place <https://www.zotero.org/entities/place/d89e1a30-2dd0-582a-9551-4b6623e01c69> ;
		zot:shortTitle "历史是一场骗局考古学与历史学之间的对抗与怨恨" ;
		zot:dateModified "2024-12-12T20:59:10Z"^^xsd:dateTime ;
		zot:tags <https://www.zotero.org/entities/tag/b16cd58d-8b07-5b62-b816-19eb5f526c45> , <https://www.zotero.org/entities/tag/b611c46d-9364-5af3-8eed-50e0832d1613> , <https://www.zotero.org/entities/tag/d4734122-5642-5320-869d-5143fdd15913> , <https://www.zotero.org/entities/tag/f1188b33-b2aa-5bb5-bcb5-3199748af35e> ;
		zot:callNumber "0" ;
		zot:key "WQR3V47K" ;
		zot:inLibrary <https://www.zotero.org/groups/open-access_history_books> ;
		zot:libraryCatalog "0" ;
		owl:sameAs <https://library.oapen.org/handle/20.500.12657/45847> ;
		zot:abstractNote "This book considers ‘history’ through its supplementary function to the field rather than the ground of a study, bringing new insights into historical thinking and historiography across the humanities. It fosters engagement from around the disciplines in historical thinking and invites historians and philosophers of history to see the impact of their work outside of their own specific fields. \n  \n Essays in this volume discuss music history, linguistics, dance studies, paintings, film and archaeology. This book is essential reading for those interested in the practice of history, philosophy and the humanities more broadly.\n\n【摘要翻译】本书从 \"历史 \"对研究领域的补充作用而非研究基础的角度来审视 \"历史\"，为整个人文学科的历史思维和历史学带来了新的见解。它促进了各学科对历史思维的参与，并邀请历史学家和历史哲学家看到他们的工作在各自特定领域之外的影响。\n  \n 本卷中的文章讨论了音乐史、语言学、舞蹈研究、绘画、电影和考古学。对于那些对历史学、哲学和更广泛的人文学科的实践感兴趣的人来说，本书是不可或缺的读物。" ;
		zot:itemType "bookSection" ;
		zot:accessDate "2023-06-27T19:22:27Z"^^xsd:dateTime ;
		zot:dateAdded "2023-10-24T14:19:29Z"^^xsd:dateTime ;
