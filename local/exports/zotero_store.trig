		zot:shortTitle "十九世纪早期越南的乡村叛乱和社会暴力" ;
		zot:dateModified "2024-12-12T20:59:42Z"^^xsd:dateTime ;
		zot:tags <https://www.zotero.org/entities/tag/b16cd58d-8b07-5b62-b816-19eb5f526c45> , <https://www.zotero.org/entities/tag/3eb01dd9-c729-5464-af6a-cfdc05f061df> , <https://www.zotero.org/entities/tag/807b7762-2495-5a0c-8298-ff7931603bf9> , <https://www.zotero.org/entities/tag/3d6cb796-3f18-5842-a0b5-888b392633e1> , <https://www.zotero.org/entities/tag/489a4e59-5115-5440-83a5-524268c303f4> , <https://www.zotero.org/entities/tag/62fb2819-011e-512c-b5e5-98a12b7fe694> ;
