		zot:date "2018"^^xsd:gYear ;
		zot:publisher <https://www.zotero.org/entities/publisher/749f3aeb-78ae-5ffa-b663-6a3084c8aacb> ;
		zot:ISBN "978-1-4742-7130-1" ;
		zot:pages "141-158" ;
		zot:creators _:ebbc7835dc8391afe3bfe494f8a641b6 , _:fb4789cfb72062509d113259e126ed07 , _:fcec09fdc267efb89a19e0086bfbf1ec ;
		zot:url <https://library.oapen.org/handle/20.500.12657/45847> ;
		rdfs:label "Kelly: History as a Scam: Confrontation and Resentment Between Archaeology and History (2018)" .
