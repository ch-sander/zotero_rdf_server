    rdfs:label "coordinates of place of birth"@en ;
    sh:name "coordinates of place of birth"@en ;
    sh:description "Coordinates of the place of birth from Wikidata"@en ;
    sh:path (
        wdt:P19
        wdt:P625
    ) ;
    sh:node zotsn:wktliteral_1054 ;
    sh:nodeKind sh:Literal ;
    sh:datatype geo:wktLiteral ;
    dash:searchWidget core:MapProperty ;
    core:sparqlService zotsn:qleverWikidataService ;
    core:executedAfter true ;
    core:enableOptional true ;
    core:enableNegation false ;
    sh:order 41 .


zotsn:wdPlaceOfBirthCountry
    a sh:PropertyShape ;
    rdfs:label "country of place of birth"@en ;
    sh:name "country of place of birth"@en ;
    sh:description "Country of the place of birth from Wikidata"@en ;
    sh:path (
        wdt:P19
        wdt:P17
    ) ;
    sh:node zotsn:wikidataEntityLeaf ;
    sh:nodeKind sh:IRI ;
    dash:searchWidget core:AutocompleteProperty ;
    core:sparqlService zotsn:qleverWikidataService ;
    core:executedAfter true ;
    core:enableOptional true ;
    core:enableNegation false ;
    sh:order 42 .


