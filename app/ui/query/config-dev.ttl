zotsn:property_1803 a sh:PropertyShape ;
    rdfs:label "identifies as"@en ;
    volipi:message "A propterty path for transitive and inversive tracing of named nodes within and outside the triple store (This is only a query pattern)"@en ;
    dash:searchWidget sparnatural:AutocompleteProperty ;
    sh:description "A propterty path for transitive and inversive tracing of named nodes within and outside the triple store"@en ;
    sh:name "identifies as"@en ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:class zot:Tag ;
                sh:node zotsn:tag_1502 ] [ sh:class zotsn:Link ;
                sh:node zotsn:link_1728 ] [ sh:class zot:Agent ;
                sh:node zotsn:agent_1742 ] [ sh:class semz:Concept ;
                sh:node zotsn:concept_1761 ] [ sh:class semz:Entity ;
                sh:node zotsn:entity_1762 ] [ sh:class semz:Reference ;
                sh:node zotsn:reference_1763 ] [ sh:class zot:Place ;
                sh:node zotsn:place_1772 ] [ sh:class zot:Publisher ;
                sh:node zotsn:publisher_1773 ] ) ;
    sh:path [ sh:zeroOrMorePath [ sh:alternativePath ( owl:sameAs [ sh:inversePath owl:sameAs ] ) ] ] .

zotsn:property_1868 a sh:PropertyShape ;
    rdfs:label "belongs to Item"@en ;
    volipi:message "The parent item of the related note, e.g. a book (This is only a query pattern)"@en ;
    dash:searchWidget sparnatural:AutocompleteProperty ;
    sh:description "The parent item of the related note, e.g. a book"@en ;
    sh:name "belongs to Item"@en ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:class zot:Item ;
                sh:node zotsn:item_1498 ] [ sh:class zot:Note ;
                sh:node zotsn:note_1559 ] ) ;
    sh:path ( [ sh:zeroOrOnePath semz:inNote ] [ sh:zeroOrMorePath zot:parentItem ] ) .

zotsn:property_2067 a sh:PropertyShape ;
    rdfs:label "is referred to in"@en ;
    volipi:message "A knowledge base resource that is refered to (This is only a query pattern)"@en ;
    dash:searchWidget sparnatural:AutocompleteProperty ;
    sh:description "A knowledge base resource that is refered to"@en ;
    sh:name "is referred to in"@en ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:class zot:Item ;
                sh:node zotsn:item_1498 ] [ sh:class zot:Note ;
                sh:node zotsn:note_1559 ] [ sh:class semz:SemanticNote ;
                sh:node zotsn:semanticnote_1755 ] [ sh:class semz:Structure ;
                sh:node zotsn:structure_1756 ] [ sh:class semz:Locator ;
                sh:node zotsn:locator_1757 ] [ sh:class semz:Paragraph ;
                sh:node zotsn:paragraph_1758 ] [ sh:class semz:Quotation ;
                sh:node zotsn:quotation_1760 ] ) ;
    sh:path ( [ sh:oneOrMorePath [ sh:inversePath owl:sameAs ] ] [ sh:alternativePath ( semz:inNote semz:inStructure semz:hasLocator semz:inDoc semz:inQuotation ) ] [ sh:zeroOrMorePath zot:parentItem ] ) .

