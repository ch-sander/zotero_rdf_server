                sh:node zotsn:place_1772 ] [ sh:class zot:Publisher ;
                sh:node zotsn:publisher_1773 ] ) ;
    sh:path ( [ sh:zeroOrMorePath [ sh:inversePath zot:parentItem ] ] [ sh:alternativePath ( [ sh:inversePath semz:inNote ] [ sh:inversePath semz:inStructure ] [ sh:inversePath semz:hasLocator ] [ sh:inversePath semz:inDoc ] [ sh:inversePath semz:inQuotation ] ) ] [ sh:oneOrMorePath owl:sameAs ] ) .

semz:hasLocator a owl:ObjectProperty ;
    rdfs:label "hasLocator"@en ;
    sparnatural:tooltip "The preceding related locator of something"@en ;
    rdfs:comment "The preceding related locator of something"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:Structure ] ;
    rdfs:range semz:Locator .

semz:inDoc a owl:ObjectProperty ;
    rdfs:label "inDoc"@en ;
    sparnatural:sparqlString "<https://semantic-html.org/vocab#inDoc>+"@en ;
    sparnatural:tooltip "The parent paragraph of something (transitive property)"@en ;
    rdfs:comment "The parent paragraph of something"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:Structure ] ;
    rdfs:range [ a owl:Class ;
            grace:unionOf semz:Paragraph,
                semz:Quotation,
                semz:SemanticNote,
                semz:Semantics ] .

semz:inQuotation a owl:ObjectProperty ;
