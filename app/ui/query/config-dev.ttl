semz:belongs_to_item rdfs:label "belongs to Item"@en ;
    sparnatural:tooltip "The parent item of the related note, e.g. a book (This is only a query pattern)" .

semz:carries rdfs:label "carries"@en ;
    sparnatural:tooltip "The item carries some semantic object (This is only a query pattern)" .

semz:concept_in rdfs:label "concept in"@en ;
    sparnatural:tooltip "A knowledge base resource that is refered to (This is only a query pattern)" .

semz:instructure_transitive rdfs:label "inStructure transitive"@en ;
    sparnatural:tooltip "The parent structure of something, transitive, i.e. traverses all parent structures, too (This is only a query pattern)" .

semz:is_locator_of rdfs:label "is Locator of"@en ;
    sparnatural:sparqlString "<https://semantic-html.org/vocab#is_locator_of>+" ;
    sparnatural:tooltip "The preceding locator refering to something else (This is only a query pattern) (transitive property)" .

semz:is_note_of rdfs:label "is Note of"@en ;
    sparnatural:sparqlString "^<https://semantic-html.org/vocab#inNote>" ;
    sparnatural:tooltip "The semantic items contained in a Note (This is only a query pattern)" .

semz:is_paragraph_of rdfs:label "is Paragraph of"@en ;
    sparnatural:sparqlString "<https://semantic-html.org/vocab#is_paragraph_of>+" ;
    sparnatural:tooltip "The paragraph containing something else (This is only a query pattern) (transitive property)" .

semz:is_quotation_of rdfs:label "is Quotation of"@en ;
    sparnatural:sparqlString "<https://semantic-html.org/vocab#is_quotation_of>+" ;
    sparnatural:tooltip "The quotation paragraph containing something else (This is only a query pattern) (transitive property)" .

semz:is_structure_of rdfs:label "is Structure of"@en ;
    sparnatural:sparqlString "<https://semantic-html.org/vocab#is_structure_of>+" ;
    sparnatural:tooltip "The preceding structure refering to something else (This is only a query pattern) (transitive property)" .

semz:referred_to rdfs:label "referred to"@en ;
    sparnatural:tooltip "A knowledge base resource that is refered to (This is only a query pattern)" .

semz:refers_to rdfs:label "refers to"@en ;
    sparnatural:tooltip "A knowledge base resource that is refered to (This is only a query pattern)" .

semz:sameAs rdfs:label "sameAs"@en ;
    sparnatural:tooltip "A propterty path for transitive and inversive tracing of named nodes within and outside the triple store (This is only a query pattern)" .

grace: a owl:Ontology ;
    rdfs:label "Graceful17 Ontology"@en ;
    dc:title "Graceful17 Ontology"@en ;
    dct:created "2026-07-28T18:52:28"@en ;
    dct:creator "Bruno Boute"@en,
        "Christoph Sander"@en ;
    dct:license <http://creativecommons.org/licenses/by/4.0/> ;
    ns1:status <http://purl.org/ontology/bibo/status/draft> ;
    vann:preferredNamespacePrefix "grace"@en ;
    vann:preferredNamespaceUri "https://w3id.org/grace/ontology/" ;
    owl:backwardCompatibleWith grace:1.0.0 ;
    owl:imports <http://www.opengis.net/ont/geosparql> ;
    owl:priorVersion grace:1.0.0 ;
    owl:versionIRI grace:1.0.1 ;
    prov:generatedAtTime "2026-07-28T18:52:28"^^xsd:dateTime ;
    schema:citation "Sander, Christoph; Boute, Bruno. (2025). The Graceful17 Ontology, https://w3id.org/g17/ontology (Version 1.0.1)"@en .

