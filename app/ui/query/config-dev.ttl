semz:belongs_to_item a owl:ObjectProperty ;
    rdfs:label "belongs to Item"@en ;
    sparnatural:tooltip "The parent item of the related note, e.g. a book (This is only a query pattern)"@en ;
    rdfs:comment "The parent item of the related note, e.g. a book"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:SemanticNote,
                semz:Structure ] ;
    rdfs:range [ a owl:Class ;
            grace:unionOf zot:Item,
                zot:Note ] .

semz:carries a owl:ObjectProperty ;
    rdfs:label "carries"@en ;
    sparnatural:tooltip "The item carries some semantic object (This is only a query pattern)"@en ;
    rdfs:comment "The item carries some semantic object"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf zot:Item,
                zot:Note ] ;
    rdfs:range [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:SemanticNote,
                semz:Structure ] .

semz:concept_in a owl:ObjectProperty ;
    rdfs:label "concept in"@en ;
    sparnatural:tooltip "A knowledge base resource that is refered to (This is only a query pattern)"@en ;
    rdfs:comment "A knowledge base resource that is refered to"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf zot:Item,
                zot:Note,
                semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Reference ] ;
    rdfs:range [ a owl:Class ;
            grace:unionOf zot:Agent,
                zot:Place,
                zot:Publisher,
                zot:Tag,
                zotsn:Link,
                semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Reference ] .

semz:has_label a owl:DatatypeProperty ;
    rdfs:label "has Label"@en ;
    sparnatural:tooltip "The default label of a resource (This is only a query pattern)"@en ;
    rdfs:comment "The default label of a resource"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf zot:Agent,
                zot:Note,
                zot:Place,
                zot:Publisher,
                semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:SemanticNote,
                semz:Structure ] ;
    rdfs:range zotsn:Text .

semz:instructure_transitive a owl:ObjectProperty ;
    rdfs:label "inStructure transitive"@en ;
    sparnatural:tooltip "The parent structure of something, transitive, i.e. traverses all parent structures, too (This is only a query pattern)"@en ;
    rdfs:comment "The parent structure of something, transitive, i.e. traverses all parent structures, too"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:Structure ] ;
    rdfs:range semz:Structure .

semz:is_locator_of a owl:ObjectProperty ;
    rdfs:label "is Locator of"@en ;
    sparnatural:sparqlString "<https://semantic-html.org/vocab#is_locator_of>+"@en ;
    sparnatural:tooltip "The preceding locator refering to something else (This is only a query pattern) (transitive property)"@en ;
    rdfs:comment "The preceding locator refering to something else"@en ;
    rdfs:domain semz:Locator ;
    rdfs:range [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:Structure ] ;
    owl:inverseOf semz:hasLocator .

semz:is_note_of a owl:ObjectProperty ;
    rdfs:label "is Note of"@en ;
    sparnatural:sparqlString "^<https://semantic-html.org/vocab#inNote>"@en ;
    sparnatural:tooltip "The semantic items contained in a Note (This is only a query pattern)"@en ;
    rdfs:comment "The semantic items contained in a Note"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf zot:Note,
                semz:SemanticNote ] ;
    rdfs:range [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:Structure ] ;
    owl:inverseOf semz:inNote .

semz:is_paragraph_of a owl:ObjectProperty ;
    rdfs:label "is Paragraph of"@en ;
    sparnatural:sparqlString "<https://semantic-html.org/vocab#is_paragraph_of>+"@en ;
    sparnatural:tooltip "The paragraph containing something else (This is only a query pattern) (transitive property)"@en ;
    rdfs:comment "The paragraph containing something else"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf semz:Paragraph,
                semz:Quotation,
                semz:SemanticNote,
                semz:Semantics ] ;
    rdfs:range [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:Structure ] ;
    owl:inverseOf semz:inDoc .

semz:is_quotation_of a owl:ObjectProperty ;
    rdfs:label "is Quotation of"@en ;
    sparnatural:sparqlString "<https://semantic-html.org/vocab#is_quotation_of>+"@en ;
    sparnatural:tooltip "The quotation paragraph containing something else (This is only a query pattern) (transitive property)"@en ;
    rdfs:comment "The quotation paragraph containing something else"@en ;
    rdfs:domain semz:Quotation ;
    rdfs:range [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:Structure ] ;
    owl:inverseOf semz:inQuotation .

semz:is_structure_of a owl:ObjectProperty ;
    rdfs:label "is Structure of"@en ;
    sparnatural:sparqlString "<https://semantic-html.org/vocab#is_structure_of>+"@en ;
    sparnatural:tooltip "The preceding structure refering to something else (This is only a query pattern) (transitive property)"@en ;
    rdfs:comment "The preceding structure refering to something else"@en ;
    rdfs:domain semz:Structure ;
    rdfs:range [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:Structure ] ;
    owl:inverseOf semz:inStructure .

semz:referred_to a owl:ObjectProperty ;
    rdfs:label "referred to"@en ;
    sparnatural:tooltip "A knowledge base resource that is refered to (This is only a query pattern)"@en ;
    rdfs:comment "A knowledge base resource that is refered to"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf zot:Agent,
                zot:Place,
                zot:Publisher,
                zot:Tag,
