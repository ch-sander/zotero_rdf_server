zotsn:called a owl:DatatypeProperty ;
    rdfs:label "called"@en ;
    sparnatural:enableOptional false ;
    sparnatural:tooltip "A primary name of a resource (This is only a query pattern)"@en ;
    rdfs:comment "A primary name of a resource"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf zot:Agent,
                zot:Collection,
                zot:CreatorRole,
                zot:Item,
                zot:Library,
                zot:Place,
                zot:Publisher,
                zot:Tag,
                zmap:Entry ] ;
    rdfs:range zotsn:Text .

