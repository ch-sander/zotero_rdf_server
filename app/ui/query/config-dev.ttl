semz:sameAs a owl:ObjectProperty ;
    rdfs:label "sameAs"@en ;
    sparnatural:tooltip "A propterty path for transitive and inversive tracing of named nodes within and outside the triple store (This is only a query pattern)"@en ;
    rdfs:comment "A propterty path for transitive and inversive tracing of named nodes within and outside the triple store"@en ;
