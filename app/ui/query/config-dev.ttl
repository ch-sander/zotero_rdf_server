zotsn:property_2284 a sh:PropertyShape ;
    rdfs:label "contains one word" ;
    sparnatural_datasource:datasource sparnatural_datasource:EnteredSearchTermDatasource ;
    volipi:message "This search only work in QLever. Do not visualize the object, does not accept VALUES (This is only a query pattern)" ;
    dash:searchWidget sparnatural:AutocompleteProperty ;
    sh:description "This search only work in QLever. Do not visualize the object, does not accept VALUES" ;
    sh:name "contains one word" ;
    sh:or ( [ sh:datatype zotsn:Text ;
                sh:node zotsn:text_1724 ;
                sh:nodeKind sh:Literal ] [ sh:datatype zotsn:Number ;
                sh:node zotsn:number_1726 ;
                sh:nodeKind sh:Literal ] [ sh:datatype ql:search_term ;
                sh:node zotsn:search_term_2283 ;
                sh:nodeKind sh:Literal ] ) ;
    sh:path ( rdfs:label ql:has-word ) .

