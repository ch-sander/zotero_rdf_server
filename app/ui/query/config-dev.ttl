semz:inNote a owl:ObjectProperty ;
    rdfs:label "inNote"@en ;
    sparnatural:tooltip "The parent note of something"@en ;
    rdfs:comment "The parent note of something"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:Structure ] ;
    rdfs:range [ a owl:Class ;
            grace:unionOf zot:Note,
                semz:SemanticNote ] .

