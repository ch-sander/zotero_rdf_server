geosparql:Geometry a rdfs:Class ;
    rdfs:label "Geometry"@en ;
    sparnatural:faIcon "fa-solid fa-map" ;
    sparnatural:tooltip "Tooltip for Geometry" .

cito:isCitedBy a owl:ObjectProperty ;
    rdfs:label "isCitedBy"@en ;
    sparnatural:tooltip "Tooltip for isCitedBy" ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( zot:Item zotsn:Link ) ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( zot:Item zotsn:Link ) ] ;
    owl:inverseOf cito:cites .

ql:TextContext rdfs:label "TextContext"@en ;
    sparnatural:faIcon "fa-solid fa-question" ;
    sparnatural:tooltip "Tooltip for TextContext (This is only a query pattern)" .

<http://www.opengis.net/ont/geosparql#http://www.opengis.net/ont/geosparql#> rdfs:label "OpenGIS"@en ;
    sparnatural:tooltip "Tooltip for OpenGIS" .

zot:has_location rdfs:label "has location"@en ;
    sparnatural:tooltip "Tooltip for has location (This is only a query pattern)" .

zotsn:GeoLocation rdfs:label "GeoLocation"@en ;
    sparnatural:faIcon "fa-solid fa-map" ;
    sparnatural:tooltip "A geolocation used for view on a map (This is only a query pattern)" .

