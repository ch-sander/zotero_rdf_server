                semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Reference ] ;
    rdfs:range [ a owl:Class ;
            grace:unionOf zot:Item,
                zot:Note,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:SemanticNote,
                semz:Structure ] .

semz:refers_to a owl:ObjectProperty ;
    rdfs:label "refers to"@en ;
    sparnatural:tooltip "A knowledge base resource that is refered to (This is only a query pattern)"@en ;
    rdfs:comment "A knowledge base resource that is refered to"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf zot:Item,
                zot:Note,
                semz:Locator,
