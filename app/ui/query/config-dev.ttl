zot:place a owl:DatatypeProperty ;
    rdfs:label "place"@en ;
    sparnatural:tooltip "Tooltip for place"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf zot:AudioRecording,
                zot:Book,
                zot:BookSection,
                zot:ComputerProgram,
                zot:ConferencePaper,
                zot:DictionaryEntry,
                zot:EncyclopediaArticle,
                zot:Hearing,
                zot:Item,
                zot:Manuscript,
                zot:Map,
                zot:NewspaperArticle,
                zot:Patent,
