    sh:description "The paragraph containing something else"@en ;
    sh:name "is paragraph of"@en ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:class semz:Structure ;
                sh:node zotsn:structure_1756 ] [ sh:class semz:Locator ;
                sh:node zotsn:locator_1757 ] [ sh:class semz:Paragraph ;
                sh:node zotsn:paragraph_1758 ] [ sh:class semz:Annotation ;
                sh:node zotsn:annotation_1759 ] [ sh:class semz:Quotation ;
                sh:node zotsn:quotation_1760 ] [ sh:class semz:Concept ;
                sh:node zotsn:concept_1761 ] [ sh:class semz:Entity ;
                sh:node zotsn:entity_1762 ] [ sh:class semz:Reference ;
                sh:node zotsn:reference_1763 ] ) ;
    sh:path [ sh:inversePath semz:inDoc ] .

