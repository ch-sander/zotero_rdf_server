zmap:has_mapping_label a owl:DatatypeProperty ;
    rdfs:label "has mapping label"@en ;
    sparnatural:tooltip "A label of mapping targeted by node (inverse) (This is only a query pattern)"@en ;
    rdfs:comment "A label of mapping targeted by node (inverse)"@en ;
    rdfs:domain [ a owl:Class ;
            grace:unionOf skos:Concept,
                zot:Agent,
                zot:Place,
                zot:Publisher,
                zot:Tag,
                semz:Annotation,
                semz:Concept,
                semz:Entity,
                semz:Locator,
                semz:Paragraph,
                semz:Quotation,
                semz:Reference,
                semz:SemanticNote,
                semz:Semantics,
                semz:Structure ] ;
    rdfs:range zotsn:Text .

zmap:target_of a owl:ObjectProperty ;
