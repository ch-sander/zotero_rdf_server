zotsn:property_2065 a sh:PropertyShape ;
    rdfs:label "concept in"@en ;
    volipi:message "A knowledge base resource that is refered to (This is only a query pattern)"@en ;
    dash:searchWidget sparnatural:AutocompleteProperty ;
    sh:description "A knowledge base resource that is refered to"@en ;
    sh:name "concept in"@en ;
    sh:nodeKind sh:IRI ;
    sh:or ( [ sh:class zot:Tag ;
                sh:node zotsn:tag_1502 ] [ sh:class zotsn:Link ;
                sh:node zotsn:link_1728 ] [ sh:class zot:Agent ;
                sh:node zotsn:agent_1742 ] [ sh:class semz:Annotation ;
                sh:node zotsn:annotation_1759 ] [ sh:class semz:Concept ;
                sh:node zotsn:concept_1761 ] [ sh:class semz:Entity ;
