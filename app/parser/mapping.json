{
    "@type": [
      "SemanticNote"
    ],
    "Document": {
        "xpath": [
            "//p"
        ],
      "types": [
        "Paragraph"
      ]
    },
    "Annotation": {
        "Entity": {
            "xpath": [
                "//em | //i | //span[contains(@style, \"italic\")]"
            ],
            "split": "\\s*(?:,|\\band\\b|\\+|\\&)\\s*",
            "types": [
                "Entity"
            ]
        },
        "Concept": {
            "xpath": [
                "//strong"
            ],
            "types": [
                "Concept"
            ],
            "split": "\\s*(?:,|\\band\\b|\\+|\\&)\\s*"
        },
        "Reference": {
            "xpath": [
                "//u"
            ],
            "types": [
                "Reference"
            ]
        }
    },
    "Locator": {
        "xpath": [
            "//code"
        ],
        "types": [
            "Page-Locator"
        ]
    },
    "Structure": {
        "xpath": [
            "//h1",
            "//h2",
            "//h3",
            "//h4",
            "//h5",
            "//h6"
        ],
        "types": [
            "Structure"
        ]
    },
    "Quotation": {
        "xpath": [
            "//blockquote"
        ],
        "types": [
            "Quotation"
        ]
    },
    "IGNORE": {
        "xpath": [
            "//pre"
        ],
        "regex": [
            "#"
        ]
    },
    "@context": {
      "prov": "http://www.w3.org/ns/prov#",
      "owl": "http://www.w3.org/2002/07/owl#",
      "@vocab": "https://semantic-html.org/vocab#",
      "note": {
        "@id": "inNote",
        "@type": "@id"
      },
      "structure": {
        "@id": "inStructure",
        "@type": "@id"
      },
      "locator": {
        "@id": "hasLocator",
        "@type": "@id"
      },
      "sameAs": {
        "@type": "@id"
      },
      "doc": {
        "@id": "inDoc",
        "@type": "@id"
      },
      "level": {
        "@id": "doco:hasLevel",
        "@type": "xsd:int"
      },
      "generatedAtTime": {
        "@id": "prov:generatedAtTime",
        "@type": "xsd:dateTime"
      }
    },
      "KnowledgeBase": [
        {
            "comment":"The source dataset usually contains the entities, e.g. from Zotero notes, that are to be mapped to persistent entities in knowledge base (set in knowledgeBaseGraph), which is the target dataset.",
            "FUZZY": [
            {                
                "comment": "compares each Literal from domainProperty to each from targetProperty with a fuzzy score threshold 0-100 (set here or taken from global config. If matched a link will be created from source to target using mapProperty, the matched Literal will be added to target using altLabel, and if allowCreate is true, a new resource in target will be created, having all target property-object pairs. The JSON-LD dictionary in ADD will be added to each created resource in the target dataset.",
                "threshold": 90,
                "domainProperty": "https://semantic-html.org/vocab#text",
                "targetProperty": "http://www.w3.org/2004/02/skos/core#altLabel"
            }
            ],
            "POOL": [
            {
                "comment": "filters target and source dataset subjects by property and object. Each pair given is by default (operator key is not neccessary) an additive to the pool (OR not AND). Recursive filtering (AND) is experimental. Property or Object may be None.",
                "operator": "OR",
                "domainProperty": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
                "domainObject": "https://semantic-html.org/vocab#Entity"
            }, {
                "operator":"OR",
                "targetProperty": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
                "targetObject": "http://www.zotero.org/namespaces/export#person"
            },
            {
                "operator":"OR",
                "targetProperty": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
                "targetObject": "http://www.zotero.org/namespaces/export#place"
            }
            ],
            "SAME": [
            {
                "comment": "if source resource matches node in any target resource, FUZZY will be skipped and a link will directly be created from source to target using mapProperty.",  
                "domainProperty": "http://www.w3.org/2002/07/owl#sameAs",
                "targetProperty": "http://www.w3.org/2002/07/owl#sameAs"
            }
            ],
            "allowCreate": true,
            "mapProperty": "http://www.w3.org/2002/07/owl#sameAs",
            "altLabel": "http://www.w3.org/2004/02/skos/core#altLabel",
            "knowledgeBaseGraph": "https://scigma.de/entities",
            "ADD": {
            "http://www.w3.org/2000/01/rdf-schema#comment": {
                "@value": "Auto-generated entity from semantic note",
                "@language": "en"
            },
            "http://purl.org/dc/terms/source": {
                "@id": "https://semantic-html.org"
            }
            }
        },
        {
            "comment":"This is a second rule",
            "FUZZY": [
            {
                "threshold": 90,
                "domainProperty": "https://semantic-html.org/vocab#text",
                "targetProperty": "http://www.w3.org/2004/02/skos/core#altLabel"
            }
            ],
            "POOL": [
            {
                "operator": "OR",
                "domainProperty": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
                "domainObject": "https://semantic-html.org/vocab#Concept"
            }, {
                "operator":"OR",
                "targetProperty": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
                "targetObject": "http://www.zotero.org/namespaces/export#tag"
            }
            ],
            "SAME": [
            {
                "domainProperty": "http://www.w3.org/2002/07/owl#sameAs",
                "targetProperty": "http://www.w3.org/2002/07/owl#sameAs"
            }
            ],
            "allowCreate": true,
            "mapProperty": "http://www.w3.org/2002/07/owl#sameAs",
            "altLabel": "http://www.w3.org/2004/02/skos/core#altLabel",
            "knowledgeBaseGraph": "https://scigma.de/entities",
            "ADD": {
            "http://www.w3.org/2000/01/rdf-schema#comment": {
                "@value": "Auto-generated concept from semantic note",
                "@language": "en"
            },
            "http://purl.org/dc/terms/source": {
                "@id": "https://semantic-html.org"
            }
            }
        }
        ]
  }