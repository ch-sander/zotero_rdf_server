{
    "@type": [
      "SemanticNote"
    ],
    "Document": {
      "tags": [
        "p"
      ],
      "types": [
        "Doc"
      ]
    },
    "Annotation": {
      "Concept": {
        "tags": [
          "em"
        ],
        "styles": [
          "font-style:italic"
        ],
        "types": [
          "Annotation",
          "Concept"
        ]
      },
      "Entity": {
        "tags": [
          "strong"
        ],
        "types": [
            "Annotation",
            "Entity"
          ]
      },
      "Entity2": {
        "regex": [
          "#\\\\w+#?"
        ],
        "types": [
          "Annotation",
          "Entity"
        ]
      },
      "Reference1": {
        "tags": [
          "u"
        ],
        "types": [
          "Reference"
        ]
      },
      "Reference2": {
        "tags": [
          "span"
        ],
        "class": "citation",
        "types": [
          "Reference Zotero"
        ]
      }
    },
    "Locator": {
      "tags": [
        "code"
      ],
      "types": [
        "Page-Locator"
      ]
    },
    "Structure": {
      "tags": [
        "h1",
        "h2",
        "h3"
      ],
      "types": [
        "Structure"
      ]
    },
    "Quotation": {
      "tags": [
        "blockquote"
      ],
      "types": [
        "Quotation"
      ]
    },
    "IGNORE": {
      "tags": [
        "pre",
        "img"
      ],
      "regex": [
        "#"
      ]
    },
    "@context": {
      "prov": "http://www.w3.org/ns/prov#",
      "owl": "http://www.w3.org/2002/07/owl#",
      "@vocab": "https://semantic-html.org/vocab#",
      "note": {
        "@id": "inNote",
        "@type": "@id"
      },
      "structure": {
        "@id": "inStructure",
        "@type": "@id"
      },
      "locator": {
        "@id": "hasLocator",
        "@type": "@id"
      },
      "sameAs": {
        "@type": "@id"
      },
      "doc": {
        "@id": "inDoc",
        "@type": "@id"
      },
      "level": {
        "@id": "doco:hasLevel",
        "@type": "xsd:int"
      },
      "generatedAtTime": {
        "@id": "prov:generatedAtTime",
        "@type": "xsd:dateTime"
      }
    },
      "KnowledgeBase": [
        {
            "comment":"The source dataset usually contains the entities, e.g. from Zotero notes, that are to be mapped to persistent entities in knowledge base (set in knowledgeBaseGraph), which is the target dataset.",
            "FUZZY": [
            {                
                "comment": "compares each Literal from domainProperty to each from targetProperty with a fuzzy score threshold 0-100 (set here or taken from global config. If matched a link will be created from source to target using mapProperty, the matched Literal will be added to target using altLabel, and if allowCreate is true, a new resource in target will be created, having all target property-object pairs. The JSON-LD dictionary in ADD will be added to each created resource in the target dataset.",
                "threshold": 90,
                "domainProperty": "https://semantic-html.org/vocab#text",
                "targetProperty": "http://www.w3.org/2004/02/skos/core#altLabel"
            }
            ],
            "AND": [
            {
                "comment": "filters target and source datasets as inner join for property-object pairs.",                
                "domainProperty": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
                "domainNode": "https://semantic-html.org/vocab#Entity",
                "targetProperty": "http://www.w3.org/1999/02/22-rdf-syntax-ns#type",
                "targetNode": "http://www.zotero.org/namespaces/export#place"
            }
            ],
            "OR": [
            {
                "comment": "if source resource matches node in any target resource, FUZZY will be skipped and a link will directly be created from source to target using mapProperty.",  
                "domainProperty": "http://www.w3.org/2002/07/owl#sameAs",
                "targetProperty": "http://www.w3.org/2002/07/owl#sameAs"
            }
            ],
            "allowCreate": true,
            "mapProperty": "http://www.w3.org/2002/07/owl#sameAs",
            "altLabel": "http://www.w3.org/2004/02/skos/core#altLabel",
            "knowledgeBaseGraph": "https://www.raramagnetica.de/entities",
            "ADD": {
            "http://www.w3.org/2000/01/rdf-schema#comment": {
                "@value": "Auto-generated concept from semantic note",
                "@language": "en"
            },
            "http://purl.org/dc/terms/source": {
                "@id": "https://semantic-html.org"
            }
            }
        }
        ]
  }